rules_version = '2';

// Mökki – Firestoren säännöt (sama malli kuin veikkaussovelluksessa)
// Vain yhteisellä Firebase-tunnuksella (terokulju95@gmail.com) kirjautunut
// laite pääsee tietoihin käsiksi.
//
// VAIHDA alla oleva LIITÄ_OMA_UID_TÄHÄN tunnuksesi UID:ksi:
// Firebase Console → Authentication → Users → kopioi "User UID" -sarakkeen arvo.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "LIITÄ_OMA_UID_TÄHÄN";
    }
  }
}
